{
  "name": "sumon-trade-backend",
  "version": "1.0.0",
  "description": "Sumon Trade multi-company ERP API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "reset-password:prod": "node dist/scripts/reset-password.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "imapflow": "^2.9.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.12.4",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "private": true,
  "overrides": {
    "exceljs": {
      "unzipper": "^0.12.5",
      "fast-csv": "^5.0.8",
      "uuid": "^11.1.1"
    },
    "archiver-utils": {
      "glob": "^13.0.6"
    }
  }
}
