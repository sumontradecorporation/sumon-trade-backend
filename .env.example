NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://emonhridoy2014_db_user:FevxhGGzRHdOLTZj@vyaparapp.kis02qq.mongodb.net/vyapar_erp?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/sumon_trade
# emonhridoy2014_db_user
# FevxhGGzRHdOLTZj
# Long random strings (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Optional key (32+ characters) that encrypts the mailbox passwords saved in Settings > Email.
# Defaults to JWT_REFRESH_SECRET. Set it so you can rotate the JWT secrets without re-entering mailbox passwords.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Comma separated list of allowed browser origins when the API is called directly (not through the Next.js proxy)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Hosting storage folder for uploaded images / PDFs (absolute or relative to backend/)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Initial super admin created by `npm run seed`
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Admin@12345
# Set to false to disable cron jobs (reminders, daily summary, IMAP sync)
ENABLE_JOBS=true
APP_URL=http://localhost:3000
